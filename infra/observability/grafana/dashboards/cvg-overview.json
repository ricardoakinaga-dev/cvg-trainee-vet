{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Requests by route and outcome",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (route, outcome) (rate(api_requests_total[5m]))",
          "legendFormat": "{{route}} — {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Request duration aggregate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "1000 * sum by (route) (rate(api_request_duration_seconds_sum[5m])) / sum by (route) (rate(api_request_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "title": "Worker throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(worker_events_processed_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 4,
      "title": "Core availability",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(100 * sum(rate(api_requests_total{outcome!=\"server_error\"}[5m])) / sum(rate(api_requests_total[5m]))) and on() (sum(rate(api_requests_total[5m])) > 0)",
          "legendFormat": "availability",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 5,
      "title": "API p95 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max by (route) (api_request_duration_seconds_p95{route=~\"/api/v1/.*\"})",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 6,
      "title": "API error rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(100 * sum(rate(api_requests_total{outcome=\"server_error\"}[5m])) / sum(rate(api_requests_total[5m]))) and on() (sum(rate(api_requests_total[5m])) > 0)",
          "legendFormat": "server errors",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 7,
      "title": "Worker queue throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(worker_events_claimed_total[5m]))",
          "legendFormat": "claimed",
          "refId": "A"
        },
        {
          "expr": "sum(rate(worker_events_processed_total[5m]))",
          "legendFormat": "processed",
          "refId": "B"
        },
        {
          "expr": "sum(rate(worker_events_failed_total[5m]))",
          "legendFormat": "failed",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 8,
      "title": "Internal indexing",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(worker_events_processed_total{event_type=\"content.published.v1\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum by (outcome) (rate(worker_events_failed_total{event_type=\"content.published.v1\"}[5m]))",
          "legendFormat": "failed / {{outcome}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 9,
      "title": "Assistive AI jobs",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(worker_events_processed_total{event_type=\"ai.suggestion.requested.v1\"}[5m]))",
          "legendFormat": "processed / {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum by (outcome) (rate(worker_events_failed_total{event_type=\"ai.suggestion.requested.v1\"}[5m]))",
          "legendFormat": "failed / {{outcome}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "id": 10,
      "title": "Participant experience",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (route, outcome) (rate(api_requests_total{route=~\"/api/v1/(activities|learning|attempts).*\"}[5m]))",
          "legendFormat": "{{route}} — {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_CVG_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "id": 11,
      "title": "Observability signal integrity",
      "type": "timeseries",
      "targets": [
        {
          "expr": "up{job=~\"cvg-api|cvg-worker|alertmanager\"}",
          "legendFormat": "{{job}} / {{instance}}",
          "refId": "A"
        },
        {
          "expr": "absent(up{job=\"cvg-api\"}) or absent(up{job=\"cvg-worker\"}) or absent(up{job=\"alertmanager\"})",
          "legendFormat": "missing target",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "CVG — Operational Overview",
  "uid": "cvg-operational-overview",
  "version": 1
}
