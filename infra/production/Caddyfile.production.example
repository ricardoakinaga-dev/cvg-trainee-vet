(common_headers) {
  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
  }
}

(common_proxy) {
  encode gzip
  import common_headers
  reverse_proxy api-a:3000 api-b:3000 {
    health_uri /health/live
    health_interval 5s
    health_timeout 2s
    health_fails 3
    health_passes 2
    lb_try_duration 5s
  }
}

:8080 {
  import common_headers
  @health path /health/*
  handle @health {
    import common_proxy
  }
  @not_health not path /health/*
  redir @not_health {$CVG_PUBLIC_HTTPS_ORIGIN}{uri} 308
}

:8081 {
  import common_proxy
}

# Set CVG_CADDY_HTTPS_SITE to the approved public FQDN, for example
# training.example.org. Do not use this profile with a localhost/default site.
# Automatic HTTPS obtains and renews the managed certificate through Caddy's
# configured certificate authority; the host must publish 80 and 443.
{$CVG_CADDY_HTTPS_SITE} {
  import common_proxy
  header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
}
