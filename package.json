{
  "name": "cvg-trainee-vet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "format:check": "prettier --check 'AGENTS.md' 'apps/**/*.{ts,tsx,json,mjs,css}' 'packages/**/*.{ts,json,mjs}' 'tests/**/*.{ts,tsx}' 'scripts/**/*.mjs' '.github/workflows/**/*.{yml,yaml}' '*.{json,yaml,yml,mjs,ts}'",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project unit packages/contracts/src",
    "test:worker": "vitest run --project unit apps/worker/src",
    "test:integration:live": "node scripts/run-live-integration.mjs",
    "test:integration:qdrant": "CVG_INCLUDE_LIVE_QDRANT=true pnpm test:integration:live",
    "test:integration:extended": "CVG_INCLUDE_LIVE_RESTORE=true CVG_INCLUDE_LIVE_QDRANT=true node scripts/run-live-integration.mjs",
    "test:integration:restore": "CVG_INCLUDE_LIVE_RESTORE=true CVG_ONLY_LIVE_RESTORE=true node scripts/run-live-integration.mjs",
    "test:e2e": "node scripts/build-e2e.mjs && playwright test",
    "test:coverage": "vitest run --coverage",
    "verify:coverage-floor": "node scripts/verify-coverage-floor.mjs",
    "verify:evidence-consistency": "node scripts/verify-evidence-consistency.mjs",
    "test:load": "k6 run tests/load/k6-baseline.js",
    "test:rls:live": "node scripts/run-rls-live.mjs",
    "test:ratelimit:live": "node scripts/run-ratelimit-live.mjs",
    "test:ratelimit:restart": "pnpm exec vitest run --project integration tests/integration/ratelimit-redis-restart.test.ts",
    "mutation:closure": "node scripts/verify-mutation-closure.mjs",
    "evidence:test-summary": "node scripts/write-test-summary.mjs",
    "evidence:security-summary": "node scripts/write-security-summary.mjs",
    "evidence:redis-candidate": "node scripts/write-redis-candidate-summary.mjs",
    "evidence:restore": "node scripts/write-restore-summary.mjs",
    "staging:verify": "node scripts/run-staging.mjs verify",
    "staging:up": "node scripts/run-staging.mjs up",
    "mutation:authorization": "stryker run stryker.authorization.mjs",
    "mutation:critical": "stryker run stryker.critical.mjs",
    "mutation:worker-loop": "stryker run stryker.worker.mjs",
    "mutation:critical:closure": "node scripts/verify-mutation-critical.mjs",
    "reconcile:qdrant": "pnpm --filter @cvg/worker build && pnpm --dir apps/worker reconcile:qdrant",
    "verify:ci-contract": "node scripts/verify-ci-contract.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:traceability": "node scripts/verify-traceability.mjs",
    "verify:traceability:release": "CVG_TRACEABILITY_RELEASE=true node scripts/verify-traceability.mjs",
    "verify:architecture": "vitest run tests/integration/architecture-boundaries.test.ts",
    "verify:documentation": "node scripts/verify-documentation.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:product-definition": "node scripts/verify-product-definition.mjs",
    "verify:exposure": "node scripts/verify-public-boundary.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:same-sha": "node scripts/verify-same-sha.mjs",
    "release:evidence": "node scripts/release-evidence.mjs",
    "verify:release-evidence": "node scripts/release-evidence.mjs --self-test",
    "verify:aaa-candidate": "node scripts/verify-aaa-candidate.mjs",
    "verify:triple-aaa": "node scripts/verify-triple-aaa.mjs",
    "verify:audit-consistency": "node scripts/verify-audit-consistency.mjs",
    "verify:otel": "vitest run --project unit packages/observability/src/tracing.test.ts",
    "verify:security": "vitest run --project unit apps/api/src/security apps/api/src/routing apps/api/src/http",
    "verify:complexity": "node scripts/verify-complexity.mjs",
    "verify:cycles": "node scripts/verify-cycles.mjs",
    "verify:dead-code": "node scripts/verify-dead-code.mjs",
    "verify": "pnpm format:check && pnpm verify:ci-contract && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm verify:coverage-floor && pnpm verify:evidence-consistency && pnpm test:contract && pnpm test:worker && pnpm verify:migrations && pnpm verify:secrets && pnpm verify:traceability && pnpm verify:architecture && pnpm verify:routes && pnpm verify:complexity && pnpm verify:cycles && pnpm verify:dead-code && pnpm verify:security && pnpm verify:otel && pnpm verify:release-evidence && pnpm verify:documentation && pnpm verify:product-definition && pnpm verify:exposure"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.55.1",
    "@stryker-mutator/core": "9.3.0",
    "@stryker-mutator/typescript-checker": "9.3.0",
    "@stryker-mutator/vitest-runner": "9.3.0",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "7.29.6",
      "ajv@8.17.1": "8.18.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3"
    },
    "patchedDependencies": {
      "@qdrant/js-client-rest@1.19.0": "patches/@qdrant__js-client-rest@1.19.0.patch"
    }
  }
}
