# Copy to deploy/.env on the host. Never commit deploy/.env (gitignored as .env.*).
# Secrets come from the provider's secret store; see docs/security/secrets-management.md.

# Release identity (from .github/workflows/release.yml output)
CVG_REGISTRY=ghcr.io/ricardoakinaga-dev
CVG_IMAGE_TAG=v0.1.0

# Public edge
CVG_PUBLIC_HOST=treinamento.example.invalid
CVG_PUBLIC_ORIGIN=https://treinamento.example.invalid
CVG_ACME_EMAIL=ops@example.invalid
# Address of the proxy that terminates TLS in front of the API (comma separated).
# Leave empty until the topology is verified (RF-10 / M15).
CVG_TRUSTED_PROXIES=

# PostgreSQL roles (least privilege: cvg = migrator, cvg_app = runtime)
CVG_MIGRATOR_DB_PASSWORD=replace-with-32-random-bytes
CVG_APP_DB_PASSWORD=replace-with-32-random-bytes
# Operations role (BYPASSRLS) used only for restore/support, never by the app
CVG_ADMIN_DB_PASSWORD=replace-with-32-random-bytes

# Application secrets
CVG_AUDIT_CURSOR_SECRET=replace-with-at-least-32-random-bytes
CVG_CLINICAL_APPROVER_ID=

# Feature flags: launch with AI and Qdrant OFF (M17)
CVG_AI_ENABLED=false
CVG_QDRANT_ENABLED=false
CVG_DIAGNOSTIC_SESSION_DRAFT_ENABLED=false

# Backups
CVG_BACKUP_HOST_DIR=/var/backups/cvg
CVG_BACKUP_INTERVAL_SECONDS=3600
CVG_BACKUP_RETENTION_DAYS=14

# Observability (profile "observability")
CVG_OTEL_TRACES_ENABLED=false
CVG_ALERT_WEBHOOK_URL=
